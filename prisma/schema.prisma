generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleType {
  BREAKDOWN
  EXPLAINER
  BUILD_LOG
}

enum BottleneckTag {
  PRODUCT
  SHIPPING
  DISTRIBUTION
  FUNDING
  CLARITY
  OTHER
}

model CaseStudy {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  outcomeLine   String    @default("")
  bottleneck    String    @default("")
  context       String    @default("")
  whatWeDid     String    @default("")
  whatChanged   String    @default("")
  tags          String[]  @default([])
  coverImageUrl String    @default("")
  galleryUrls   String[]  @default([])
  liveUrl       String?
  year          Int?
  published     Boolean   @default(false)
  featured      Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published])
  @@index([publishedAt])
  @@index([featured])
  @@index([published, publishedAt])
}

model UpdatePost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  summary       String    @default("")
  body          String    @default("")
  coverImageUrl String?
  tags          String[]  @default([])
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published])
  @@index([publishedAt])
  @@index([published, publishedAt])
}

model Article {
  id            String          @id @default(cuid())
  slug          String          @unique
  title         String
  excerpt       String          @default("")
  body          String          @default("")
  articleType   ArticleType?
  bottleneckTag BottleneckTag?
  coverImageUrl String?
  tags          String[]        @default([])
  published     Boolean         @default(false)
  featured      Boolean         @default(false)
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([published])
  @@index([publishedAt])
  @@index([featured])
  @@index([articleType])
  @@index([bottleneckTag])
  @@index([published, publishedAt])
}
