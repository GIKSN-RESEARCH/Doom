# Pooled PostgreSQL connection string used by Prisma at runtime.
DATABASE_URL=

# Server-only secret expected in the x-admin-key request header.
# Generate a unique high-entropy value for each deployed environment.
ADMIN_API_KEY=

# Google Analytics 4 measurement ID (public, loaded in the browser).
# Leave empty to disable the tag. Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
